{
  "name": "@easier/embedding",
  "version": "0.1.0",
  "license": "MIT",
  "author": "Russ T Fugal <russ-fugal@smart-knowledge-systems.com>",
  "description": "Pluggable embedding providers and cost tracking for EASIER systems",
  "keywords": [
    "embeddings",
    "openai",
    "ollama",
    "embedding-provider",
    "cost-tracking"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./cost": {
      "types": "./dist/cost.d.ts",
      "import": "./dist/cost.js"
    }
  },
  "files": [
    "LICENSE",
    "dist/",
    "README.md"
  ],
  "dependencies": {
    "openai": "^4.77.0"
  },
  "peerDependencies": {
    "@easier/core": ">=0.1.0"
  },
  "peerDependenciesMeta": {
    "@easier/core": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/bun": "^1.3.10",
    "typescript": "^5.7.0"
  },
  "scripts": {
    "build": "bun run ./scripts/build.ts",
    "typecheck": "bunx tsc --noEmit"
  }
}
