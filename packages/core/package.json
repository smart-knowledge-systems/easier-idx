{
  "name": "@easier-idx/core",
  "version": "0.3.0",
  "license": "MIT",
  "author": "Russ T Fugal <russ-fugal@smart-knowledge-systems.com>",
  "description": "Embedding-Augmented Semantic Index for Efficient Retrieval — search framework with hybrid BM25/vector scoring, pluggable storage, clustering, and eval",
  "keywords": [
    "search",
    "embeddings",
    "bm25",
    "hybrid-search",
    "vector-search",
    "sqlite",
    "postgres",
    "clustering",
    "eval"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./db": {
      "types": "./dist/db/util.d.ts",
      "import": "./dist/db/util.js"
    },
    "./db/store": {
      "types": "./dist/db/store.d.ts",
      "import": "./dist/db/store.js"
    },
    "./db/sqlite": {
      "types": "./dist/db/sqlite.d.ts",
      "import": "./dist/db/sqlite.js"
    },
    "./db/pg": {
      "types": "./dist/db/pg.d.ts",
      "import": "./dist/db/pg.js"
    },
    "./db/migrate": {
      "types": "./dist/db/migrate.d.ts",
      "import": "./dist/db/migrate.js"
    },
    "./db/vector": {
      "types": "./dist/db/vector.d.ts",
      "import": "./dist/db/vector.js"
    },
    "./db/fts": {
      "types": "./dist/db/fts.d.ts",
      "import": "./dist/db/fts.js"
    },
    "./retry": {
      "types": "./dist/retry.d.ts",
      "import": "./dist/retry.js"
    },
    "./cache": {
      "types": "./dist/cache.d.ts",
      "import": "./dist/cache.js"
    },
    "./usage": {
      "types": "./dist/usage.d.ts",
      "import": "./dist/usage.js"
    },
    "./search": {
      "types": "./dist/search/scoring.d.ts",
      "import": "./dist/search/scoring.js"
    },
    "./search/bm25": {
      "types": "./dist/search/bm25.d.ts",
      "import": "./dist/search/bm25.js"
    },
    "./search/bm25-helpers": {
      "types": "./dist/search/bm25-helpers.d.ts",
      "import": "./dist/search/bm25-helpers.js"
    },
    "./eval/gate": {
      "types": "./dist/eval/gate.d.ts",
      "import": "./dist/eval/gate.js"
    },
    "./eval/metrics": {
      "types": "./dist/eval/metrics.d.ts",
      "import": "./dist/eval/metrics.js"
    },
    "./config": {
      "types": "./dist/config/config.d.ts",
      "import": "./dist/config/config.js"
    },
    "./cluster": {
      "types": "./dist/cluster/kmeans.d.ts",
      "import": "./dist/cluster/kmeans.js"
    },
    "./cluster/classify": {
      "types": "./dist/cluster/classify.d.ts",
      "import": "./dist/cluster/classify.js"
    },
    "./cluster/silhouette": {
      "types": "./dist/cluster/silhouette.d.ts",
      "import": "./dist/cluster/silhouette.js"
    },
    "./cluster/describe": {
      "types": "./dist/cluster/describe.d.ts",
      "import": "./dist/cluster/describe.js"
    }
  },
  "files": [
    "LICENSE",
    "PUBLIC_API.md",
    "dist/",
    "README.md"
  ],
  "dependencies": {
    "@easier-idx/clustering": "workspace:*",
    "@easier-idx/logging": "workspace:*",
    "sqlite-vec": "^0.1.7"
  },
  "optionalDependencies": {
    "better-sqlite3": "^11.10.0",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@types/bun": "^1.3.11",
    "typescript": "^6.0.2"
  },
  "scripts": {
    "build": "bun run ./scripts/build.ts",
    "typecheck": "bunx tsc --noEmit",
    "lint": "bunx eslint --cache src/",
    "lint:fix": "bunx eslint --cache --fix src/",
    "format": "bunx prettier --write src/ test/",
    "check": "bun run typecheck && bun run lint && bun run build",
    "test": "bun run build && bun test",
    "smoke:pack:bun": "bash ./scripts/smoke-pack-bun.sh",
    "smoke:pack:node": "bash ./scripts/smoke-pack-node.sh"
  }
}
