{
  "name": "@easier-idx/batch",
  "version": "0.1.1",
  "license": "MIT",
  "author": "Russ T Fugal <russ-fugal@smart-knowledge-systems.com>",
  "description": "Anthropic Batch API lifecycle management for EASIER systems",
  "keywords": ["batch", "anthropic", "polling", "state-machine"],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" },
    "./poll": { "types": "./dist/poll.d.ts", "import": "./dist/poll.js" },
    "./iterate": { "types": "./dist/iterate.d.ts", "import": "./dist/iterate.js" }
  },
  "files": ["LICENSE", "dist/", "README.md"],
  "dependencies": { "@easier-idx/core": "workspace:*" },
  "peerDependencies": { "@anthropic-ai/sdk": ">=0.30.0" },
  "peerDependenciesMeta": { "@anthropic-ai/sdk": { "optional": true } },
  "devDependencies": { "@types/bun": "^1.3.10", "typescript": "^5.7.0" },
  "scripts": {
    "build": "bun run ./scripts/build.ts",
    "typecheck": "bunx tsc --noEmit",
    "check": "bun run typecheck && bun run build",
    "test": "bun run build && bun test"
  }
}
