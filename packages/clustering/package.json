{
  "name": "@easier-idx/clustering",
  "version": "0.4.0",
  "license": "MIT",
  "author": "Russ T Fugal <russ-fugal@smart-knowledge-systems.com>",
  "description": "K-means clustering, kNN classification, silhouette scoring, and cluster description for EASIER systems",
  "keywords": [
    "clustering",
    "kmeans",
    "knn",
    "silhouette",
    "classification"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./classify": {
      "types": "./dist/classify.d.ts",
      "import": "./dist/classify.js"
    },
    "./silhouette": {
      "types": "./dist/silhouette.d.ts",
      "import": "./dist/silhouette.js"
    },
    "./describe": {
      "types": "./dist/describe.d.ts",
      "import": "./dist/describe.js"
    }
  },
  "files": [
    "LICENSE",
    "dist/",
    "README.md"
  ],
  "devDependencies": {
    "@types/bun": "^1.3.11",
    "typescript": "^6.0.2"
  },
  "scripts": {
    "build": "bun run ./scripts/build.ts",
    "typecheck": "bunx tsc --noEmit",
    "check": "bun run typecheck && bun run build",
    "test": "bun run build && bun test"
  }
}
