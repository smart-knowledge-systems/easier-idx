{
  "private": true,
  "workspaces": ["packages/*"],
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bun": "^1.3.11",
    "eslint": "^10.2.0",
    "prettier": "^3.8.1",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.58.1"
  },
  "scripts": {
    "build": "bun run --filter '*' build",
    "typecheck": "bun run --filter '*' typecheck",
    "test": "bun run --filter '*' test",
    "check": "bun run --filter '*' check",
    "lint": "bunx eslint --cache packages/*/src/",
    "lint:fix": "bunx eslint --cache --fix packages/*/src/",
    "format": "bunx prettier --write packages/*/src/ packages/*/test/"
  }
}
